# Copy to .env and fill in. Real environment variables take precedence over .env.

# Required by every command. The database URL: from `turso db show --url` for hosted
# Turso, or `file:dev.db` for a throwaway local SQLite file.
TURSO_DATABASE_URL=

# Required for hosted Turso, from `turso db tokens create`. Leave empty for a
# `file:` URL.
TURSO_AUTH_TOKEN=

# Optional. Where the profile directory lives; defaults to ./profile.
# JSA_PROFILE_DIR=

# Required by `jsa search --agent perplexity`, from your Perplexity account.
PERPLEXITY_API_KEY=

# An Anthropic Console API key, required on Fly when search.toml schedules `claude`: the machine has
# no Claude login to fall back on. When set, `jsa search --agent claude` runs on this key alone and
# ignores any Claude login in the environment, so leave it empty in development. See PRD 06 for what
# "production" means and when to run locally versus on Fly.
JSA_SEARCH_ANTHROPIC_API_KEY=

# Claude credential for the Claude commands (search, checklist, redline, refine) when the key above is
# unset: set CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`) or ANTHROPIC_API_KEY, never
# both. The CLI prefers the API key, so with both set the OAuth flow fails with a 401. The inbox app
# is staged with whichever one is set here.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Required by `jsa search --agent gemini`, from Google AI Studio.
GEMINI_API_KEY=

# Optional; the `gws` CLI that `jsa track` appends to the tracker Sheet with. Defaults to `gws`.
# JSA_GWS_BIN=

# Inbox app only: the owner's exported `gws` credential (the JSON text from `gws auth export --unmasked`),
# which `jsa inbox` uses for the tracker and the Drive packets folder. Leave it unset locally, where
# `gws` uses its own login.
# JSA_GWS_CREDENTIALS=

# Inbox app only: the jobs mailbox's exported `gws` credential (the JSON text from
# `gws auth export --unmasked`), for `jsa inbox`. Leave it unset locally.
# JSA_INBOX_GWS_CREDENTIALS=

# Optional; the LibreOffice binary `jsa packet` and `jsa generate` render the packet's PDFs with. Defaults to `soffice`.
# JSA_SOFFICE_BIN=

# Optional; the `fly` CLI that `jsa deploy` drives. Defaults to `fly`.
# JSA_FLY_BIN=

# Optional; how many packets (checklist and redline) `jsa generate` builds at once. Defaults to 3.
# JSA_GENERATE_WORKERS=
