# Copy to .env and fill in. Real environment variables take precedence over .env.

# Required by every command. The database URL: from `turso db show --url` for hosted
# Turso, or `file:dev.db` for a throwaway local SQLite file.
TURSO_DATABASE_URL=

# Required for hosted Turso, from `turso db tokens create`. Leave empty for a
# `file:` URL.
TURSO_AUTH_TOKEN=

# Optional. Where the profile directory lives; defaults to ./profile.
# JSA_PROFILE_DIR=

# Required by `jsa search --agent perplexity`, from your Perplexity account.
PERPLEXITY_API_KEY=
